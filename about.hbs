<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>Third-party licenses of graphersal</title></head>
<body>
<h1>Third-party licenses</h1>
<p>The graphersal binaries include the following third-party crates.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>Licenses</h2>
{{#each licenses}}
<h3 id="{{id}}">{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}
  <li>{{crate.name}} {{crate.version}}{{#if crate.repository}} (<a href="{{crate.repository}}">{{crate.repository}}</a>){{/if}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
